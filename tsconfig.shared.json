{
    "compilerOptions": {
        "module": "Node16",
        "tsBuildInfoFile": "node_modules/.cache/tsc/shared.tsbuildinfo",
        "target": "ES2022",
        "lib": ["ES2022"],
        "sourceMap": true,
        "rootDir": "src/shared",
        "outDir": "out/shared",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "composite": true
    },
    "include": [
        "src/shared/**/*.ts"
    ]
}
