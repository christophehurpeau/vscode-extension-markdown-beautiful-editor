{
  "name": "markdown-beautiful-editor",
  "displayName": "Markdown Beautiful Editor",
  "description": "A beautiful WYSIWYG-style markdown editor with visual syntax styling, GitHub alerts, and table of contents",
  "version": "0.3.3",
  "publisher": "chrp",
  "author": {
    "name": "Christophe Hurpeau"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/vscode-extension-markdown-beautiful-editor"
  },
  "bugs": {
    "url": "https://github.com/christophehurpeau/vscode-extension-markdown-beautiful-editor/issues"
  },
  "homepage": "https://github.com/christophehurpeau/vscode-extension-markdown-beautiful-editor#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.105.1"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "preview",
    "github",
    "alerts",
    "toc"
  ],
  "main": "./dist/extension.js",
  "packageManager": "pnpm@11.17.0",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "markdown.beautifulEditor",
        "displayName": "Markdown Beautiful Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "markdown.beautifulEditor.open",
        "title": "Open with Markdown Beautiful Editor",
        "category": "Markdown Beautiful Editor",
        "icon": "$(sparkle-filled)"
      },
      {
        "command": "markdown.beautifulEditor.toggleDiffMode",
        "title": "Toggle Diff Mode",
        "category": "Markdown Beautiful Editor"
      }
    ],
    "configuration": {
      "title": "Markdown Beautiful Editor",
      "properties": {
        "markdown.beautifulEditor.fontFamily": {
          "type": "string",
          "enum": [
            "normal",
            "mono"
          ],
          "enumDescriptions": [
            "Use the UI (proportional) font for prose.",
            "Use the editor (monospace) font for prose."
          ],
          "default": "normal",
          "description": "Font used for markdown content. Inline code and fenced code blocks always use the monospace editor font."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "markdown.beautifulEditor.open",
          "when": "editorLangId == markdown && !notebookEditorFocused",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "pnpm run --parallel \"/^watch:/\"",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc -b --watch",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "package:vsce": "vsce package --no-dependencies",
    "compile-tests": "tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p tsconfig.test.json -w",
    "check-types": "tsc -b && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "pnpm run compile-tests && pnpm run compile && pnpm run lint && pnpm run test:unit && pnpm run test:integration",
    "test:unit": "mocha out/test/unit/**/*.test.js",
    "test:integration": "vscode-test"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.105.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "mocha": "^10.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vsce": "2.15.0"
  },
  "dependencies": {
    "diff": "^8.0.3"
  }
}
