{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // closest to the existing code style, to keep the initial reformat small
  "printWidth": 120,
  "tabWidth": 4,
  "singleQuote": true,
  "trailingComma": "es5",
  "sortPackageJson": { "sortScripts": true },
  "overrides": [{ "files": ["package.json", ".claude/*.json", "*.{jsonc,yml,yaml,md}"], "options": { "tabWidth": 2 } }],
  "ignorePatterns": [
    "CHANGELOG.md",
    "pnpm-lock.yaml",
    // regenerated by pob-root-postinstall on every install
    "/.github/workflows/push-renovate-*.yml",
    "/.vscode",
    "/dist",
    "/out",
    "/samples",
    "/screenshots/fixtures",
    "/src/test/fixtures",
  ],
}
